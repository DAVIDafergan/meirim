generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Lead {
  id        String   @id @default(cuid())
  name      String
  phone     String
  note      String?
  createdAt DateTime @default(now())
}

model Donation {
  id                 Int       @id @default(autoincrement())
  source             String    @default("nedarim_plus")
  transactionId      String?   @unique @map("transaction_id")
  kevaId             String?   @map("keva_id")
  isRecurringSetup   Boolean   @default(false) @map("is_recurring_setup")
  clientName         String?   @map("client_name")
  phone              String?
  email              String?
  address            String?
  zeout              String?
  amount             Decimal   @db.Decimal(12, 2)
  currency           String    @default("ILS")
  category           String?
  comments           String?
  installments       Int?
  transactionTime    DateTime? @map("transaction_time")
  confirmationCode   String?   @map("confirmation_code")
  last4              String?
  cardExpiry         String?   @map("card_expiry")
  sourceChannel      String?   @map("source_channel")
  receiptUrl         String?   @map("receipt_url")
  receiptDocNum      String?   @map("receipt_doc_num")
  rawPayload         Json      @map("raw_payload")
  createdAt          DateTime  @default(now()) @map("created_at")

  @@map("donations")
}

model WebhookLog {
  id        Int      @id @default(autoincrement())
  source    String   @default("nedarim_plus")
  ip        String?
  payload   Json
  processed Boolean  @default(false)
  error     String?
  createdAt DateTime @default(now())

  @@map("webhook_logs")
}
